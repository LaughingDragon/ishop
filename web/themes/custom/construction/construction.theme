<?php

/**
 * @file
 * Construction theme: preprocess and template suggestions.
 */

use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

/**
 * Implements hook_preprocess_page().
 *
 * Supplies the site name and the current user's display name to the page
 * templates, with the cache metadata they depend on.
 */
function construction_preprocess_page(array &$variables): void {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $account = \Drupal::currentUser();
  $variables['user_name'] = $account->isAuthenticated() ? $account->getDisplayName() : '';
  $variables['#cache']['contexts'][] = 'user';
  $variables['#cache']['tags'][] = 'config:system.site';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * The "gate" layout (work-zone sign + login box) is used for the login and
 * password-reset pages and for any access-denied page shown to visitors.
 */
function construction_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $gate_routes = ['user.login', 'user.pass', 'user.reset.form', 'user.reset.login'];
  $exception = \Drupal::requestStack()->getCurrentRequest()->attributes->get('exception');
  if (in_array($route, $gate_routes, TRUE) || $exception instanceof AccessDeniedHttpException) {
    $suggestions[] = 'page__gate';
  }
}
