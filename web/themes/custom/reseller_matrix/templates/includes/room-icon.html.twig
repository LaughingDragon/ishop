{#
/**
 * @file
 * Room icons (24px grid, stroke). Usage:
 * {% include '@reseller_matrix/includes/room-icon.html.twig' with { room: 'stockroom', size: 30 } only %}
 * room: front_desk | stockroom | shipping | my_office | mailroom | calendar | break_room | add
 *   | football (a plain ball for game days: no team marks)
 */
#}
{% set s = size|default(30) %}
<svg class="rm-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if room == 'front_desk' %}<path d="M6 16v-5a6 6 0 0 1 12 0v5"/><path d="M4 16h16"/><path d="M12 5V3"/><path d="M3 20h18"/>
{% elseif room == 'stockroom' %}<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/>
{% elseif room == 'shipping' %}<path d="M2 6h11v10H2z"/><path d="M13 9h4l4 4v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
{% elseif room == 'my_office' %}<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M3 12h18"/>
{% elseif room == 'mailroom' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{% elseif room == 'calendar' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4M16 3v4"/>
{% elseif room == 'break_room' %}<path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 11h2a2 2 0 0 1 0 4h-2"/><path d="M8 3v3M12 3v3"/>
{% elseif room == 'football' %}<path d="M4.6 19.4C4 11.8 11.8 4 19.4 4.6 20 12.2 12.2 20 4.6 19.4z"/><path d="M9 15l6-6"/><path d="M10.2 11.4l2.4 2.4M12 9.6l2.4 2.4"/><path d="M6.4 14.2l3.4 3.4M14.2 6.4l3.4 3.4"/>
{% else %}<path d="M12 5v14M5 12h14"/>
{% endif %}
</svg>
