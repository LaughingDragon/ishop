<?php

/**
 * @file
 * Install and update hooks for iShop items.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\ishop_items\Platforms;

/**
 * Adds the platform listing entity type (Phase 1 step 3).
 */
function ishop_items_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('platform_listing')) {
    $type = \Drupal::entityTypeManager()->getDefinition('platform_listing');
    $manager->installEntityType($type);
  }
  return 'Platform listing entity type installed.';
}

/**
 * Adds "Date sold" to platform listings (Phase 4 step 2).
 */
function ishop_items_update_11002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getFieldStorageDefinition('date_sold', 'platform_listing')) {
    $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('platform_listing')['date_sold'];
    $manager->installFieldStorageDefinition('date_sold', 'platform_listing', 'ishop_items', $definition);
  }
  return 'Date sold added to platform listings.';
}

/**
 * Adds the category "Holiday & Seasonal" under "Home & Kitchen" (2026-10-16).
 */
function ishop_items_update_11003(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  if ($storage->loadByProperties(['vid' => 'category', 'name' => 'Holiday & Seasonal'])) {
    return 'Holiday & Seasonal already exists.';
  }
  $home = $storage->loadByProperties(['vid' => 'category', 'name' => 'Home & Kitchen']);
  $storage->create([
    'vid' => 'category',
    'name' => 'Holiday & Seasonal',
    'parent' => $home ? [(int) reset($home)->id()] : [0],
  ])->save();
  return 'Added the category Holiday & Seasonal under Home & Kitchen.';
}

/**
 * Removes the Amazon purchase and return-window parts (redesign, 2026-10-16).
 *
 * Cody sells household overstock already in the house; nothing is bought
 * to resell. Removes the fields order ID, ASIN, purchase source, purchase
 * date, return-by and "Keeping it", the purchase source vocabulary, the
 * return window settings and the status "Returned to Amazon". None of the
 * real items had data in them (checked before the change).
 */
function ishop_items_update_11004(): string {
  $done = [];
  $fields = \Drupal::entityTypeManager()->getStorage('field_config');
  $removed = [
    'field_order_id',
    'field_asin',
    'field_purchase_source',
    'field_purchase_date',
    'field_return_by',
    'field_return_keep',
  ];
  foreach ($removed as $name) {
    if ($field = $fields->load('node.item.' . $name)) {
      $field->delete();
      $done[] = $name;
    }
  }
  field_purge_batch(100);

  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms->delete($terms->loadByProperties(['vid' => 'purchase_source']));
  if ($vocabulary = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->load('purchase_source')) {
    $vocabulary->delete();
    $done[] = 'purchase_source vocabulary';
  }

  \Drupal::configFactory()->getEditable('ishop_items.returns')->delete();

  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config')->load('node.field_item_status');
  $values = $storage->getSetting('allowed_values');
  if (isset($values['returned'])) {
    unset($values['returned']);
    $storage->setSetting('allowed_values', $values)->save();
    $done[] = 'status "Returned to Amazon"';
  }
  // "Cost paid" becomes optional "What I paid (if you remember)", in Prices.
  if ($cost = \Drupal::entityTypeManager()->getStorage('field_config')->load('node.item.field_cost_paid')) {
    $cost->setLabel('What I paid (if you remember)')
      ->setRequired(FALSE)
      ->setDescription('Optional. Leave it blank if you don\'t remember; nothing asks for it.')
      ->save();
  }
  $display = \Drupal::entityTypeManager()->getStorage('entity_form_display')->load('node.item.default');
  if ($display && ($groups = $display->getThirdPartySettings('field_group'))) {
    if (isset($groups['group_prices']) && !in_array('field_cost_paid', $groups['group_prices']['children'], TRUE)) {
      $groups['group_prices']['children'][] = 'field_cost_paid';
      $display->setThirdPartySetting('field_group', 'group_prices', $groups['group_prices']);
    }
    if (isset($groups['group_purchase'])) {
      $display->unsetThirdPartySetting('field_group', 'group_purchase');
    }
    $display->save();
  }
  return 'Removed: ' . ($done ? implode(', ', $done) : 'nothing (already gone)') . '. Cost paid is now "What I paid (if you remember)".';
}

/**
 * Adds "Cleared to sell" (decision 265): posting waits until it's ticked.
 *
 * New items start unticked; the three real items (121, 255, 256) start
 * ticked, as Liam decided.
 */
function ishop_items_update_11005(): string {
  if (!FieldStorageConfig::loadByName('node', 'field_cleared_to_sell')) {
    FieldStorageConfig::create([
      'field_name' => 'field_cleared_to_sell',
      'entity_type' => 'node',
      'type' => 'boolean',
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'item', 'field_cleared_to_sell')) {
    FieldConfig::create([
      'field_name' => 'field_cleared_to_sell',
      'entity_type' => 'node',
      'bundle' => 'item',
      'label' => 'Cleared to sell',
      'description' => 'Tick once you have checked it is OK to sell. Posting waits until this is ticked.',
      'default_value' => [['value' => 0]],
      'settings' => ['on_label' => 'Cleared to sell', 'off_label' => 'Not checked yet'],
    ])->save();
  }
  $form = \Drupal::service('entity_display.repository')->getFormDisplay('node', 'item');
  $form->setComponent('field_cleared_to_sell', [
    'type' => 'boolean_checkbox',
    'weight' => 11,
    'settings' => ['display_label' => TRUE],
  ]);
  $groups = $form->getThirdPartySettings('field_group');
  if (isset($groups['group_listing']) && !in_array('field_cleared_to_sell', $groups['group_listing']['children'], TRUE)) {
    $groups['group_listing']['children'][] = 'field_cleared_to_sell';
    $form->setThirdPartySetting('field_group', 'group_listing', $groups['group_listing']);
  }
  $form->save();
  \Drupal::service('entity_display.repository')->getViewDisplay('node', 'item')
    ->removeComponent('field_cleared_to_sell')->save();

  $ticked = [];
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple([121, 255, 256]) as $node) {
    if ($node->bundle() === 'item' && !$node->get('field_cleared_to_sell')->value) {
      $node->set('field_cleared_to_sell', 1);
      $node->setNewRevision();
      $node->setRevisionLogMessage('Cleared to sell: ticked for the existing items (decision 265).');
      $node->setRevisionUserId(2);
      $node->setRevisionCreationTime(\Drupal::time()->getRequestTime());
      $node->setSyncing(TRUE);
      $node->save();
      $ticked[] = $node->id();
    }
  }
  return 'Added "Cleared to sell"; ticked items: ' . ($ticked ? implode(', ', $ticked) : 'none');
}

/**
 * Adds Check sold prices (Phase 7.5): the pricing settings and three fields.
 *
 * The fields record Cody's last answer after checking sold prices: Lower,
 * About right, Higher or a typed price, and when.
 */
function ishop_items_update_11006(): string {
  $config = \Drupal::configFactory()->getEditable('ishop_items.pricing');
  if ($config->isNew()) {
    $config->set('terapeak', FALSE)->save();
  }
  $fields = [
    'field_price_check' => [
      'list_string',
      'Sold prices check',
      [
        'allowed_values' => [
          'lower' => 'Lower',
          'about_right' => 'About right',
          'higher' => 'Higher',
          'typed' => 'Typed a price',
        ],
      ],
      'What Cody chose after checking sold prices.',
    ],
    'field_price_check_at' => [
      'timestamp',
      'Sold prices checked',
      [],
      'When Cody last checked sold prices.',
    ],
    'field_price_check_price' => [
      'decimal',
      'Price typed after checking',
      ['precision' => 10, 'scale' => 2],
      'The price Cody typed after checking sold prices, if any.',
    ],
  ];
  foreach ($fields as $name => [$type, $label, $settings, $description]) {
    if (!FieldStorageConfig::loadByName('node', $name)) {
      FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'type' => $type,
        'settings' => $settings,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'item', $name)) {
      FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'bundle' => 'item',
        'label' => $label,
        'description' => $description,
      ])->save();
    }
  }
  // Set by the Check sold prices form only: not on the edit form or the page.
  $repository = \Drupal::service('entity_display.repository');
  $form = $repository->getFormDisplay('node', 'item');
  $view = $repository->getViewDisplay('node', 'item');
  foreach (array_keys($fields) as $name) {
    $form->removeComponent($name);
    $view->removeComponent($name);
  }
  $form->save();
  $view->save();
  return 'Added the pricing settings and the Check sold prices fields.';
}

/**
 * Adds eBay as a platform (items 278 and 280, 2026-10-16).
 *
 * Updates the listing's platform field (its allowed values come from
 * Platforms::PLATFORMS), adds the post_ebay image style (1600 px, not
 * square, like post_grailed) and gives every existing item an eBay row
 * set to To post.
 */
function ishop_items_update_11007(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $manager->updateFieldStorageDefinition(
    \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('platform_listing')['platform']
  );

  $styles = \Drupal::entityTypeManager()->getStorage('image_style');
  if (!$styles->load('post_ebay') && ($grailed = $styles->load('post_grailed'))) {
    $style = $grailed->createDuplicate();
    $style->set('name', 'post_ebay');
    $style->set('label', 'Post: eBay (1600px)');
    $style->save();
  }

  $listings = \Drupal::entityTypeManager()->getStorage('platform_listing');
  $nids = \Drupal::entityQuery('node')->accessCheck(FALSE)->condition('type', 'item')->execute();
  $have = [];
  foreach ($listings->loadByProperties(['platform' => 'ebay']) as $listing) {
    $have[(int) $listing->get('item')->target_id] = TRUE;
  }
  $added = [];
  foreach ($nids as $nid) {
    if (isset($have[(int) $nid])) {
      continue;
    }
    $listing = $listings->create([
      'item' => $nid,
      'platform' => 'ebay',
      'status' => Platforms::TO_POST,
    ]);
    $listing->setRevisionLogMessage('Added when eBay became a platform (2026-10-16).');
    $listing->setRevisionUserId(2);
    $listing->save();
    $added[] = $nid;
  }
  return 'eBay added: image style post_ebay; To post rows for items ' . ($added ? implode(', ', $added) : 'none');
}
