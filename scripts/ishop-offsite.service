[Unit]
Description=ishop: copy the nightly backups to Cloud Storage (off the VM)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=/etc/default/ishop-offsite
# gcloud needs a writable config folder; credentials come from the VM.
Environment=CLOUDSDK_CONFIG=/var/lib/ishop-offsite/gcloud HOME=/var/lib/ishop-offsite
StateDirectory=ishop-offsite
ExecStart=/var/www/ishop/scripts/ishop-offsite.sh
