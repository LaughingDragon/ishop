# TEMPORARY (birthday mode): see TEMPORARY.md.
[Unit]
Description=ishop: Cody's birthday email (sends only on the day, once)
After=mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=HOME=/tmp
PrivateTmp=true
WorkingDirectory=/var/www/ishop
ExecStart=/var/www/ishop/vendor/bin/drush ishop:birthday-mail
